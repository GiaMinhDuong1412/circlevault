{
  "name": "circlevault",
  "productName": "CircleVault",
  "version": "0.0.0",
  "description": "CircleVault – tải video, phim, nhạc về ổ cứng cá nhân và nghe nhạc có bộ chỉnh âm",
  "main": "src/main.js",
  "author": "GiaMinhDuong1412",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "vn.circlevault.app",
    "productName": "CircleVault",
    "executableName": "CircleVault",
    "copyright": "GiaMinhDuong1412",
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      { "from": "res/app", "to": "app" },
      { "from": "res/python", "to": "python" },
      { "from": "res/bin", "to": "bin" }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronLanguages": ["en-US", "vi"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CircleVault",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "CircleVault-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CircleVault-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GiaMinhDuong1412",
        "repo": "circlevault-releases",
        "releaseType": "release"
      }
    ]
  }
}
